# Gojek API Configuration
# Copy this file to .env and fill in your values

# Required: Your phone number (without country code prefix)
# Example: 81234567890
GOJEK_PHONE_NUMBER=

# Required: Client credentials
GOJEK_CLIENT_ID=gojek:consumer:app

# Required: client secret for authentication (obtain by decompiling the Gojek APK)
GOJEK_CLIENT_SECRET=

# Optional: X-E1 signature header (captured per-request signature from mitmproxy)
# X-E1 is tied to URL path and expires quickly - capture fresh for each session
GOJEK_X_E1=
